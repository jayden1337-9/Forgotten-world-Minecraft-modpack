{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.forgotten.abyss_watcher": {
      "initial_state": "default",
      "states": {
        "default": { "animations": ["idle"], "transitions": [{ "moving": "query.modified_move_speed > 0.01" }] },
        "moving": { "animations": ["walk"], "transitions": [{ "default": "query.modified_move_speed <= 0.01" }] }
      }
    }
  }
}