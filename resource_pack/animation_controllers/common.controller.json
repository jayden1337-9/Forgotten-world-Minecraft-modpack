{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.forgotten.common": {
      "initial_state": "idle",
      "states": {
        "idle": {
          "animations": ["idle"],
          "transitions": [
            { "moving": "query.modified_move_speed > 0.01" }
          ]
        },
        "moving": {
          "animations": ["walk"],
          "transitions": [
            { "idle": "query.modified_move_speed <= 0.01" }
          ]
        }
      }
    }
  }
}
